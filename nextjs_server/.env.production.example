# Production Environment Variables for Railway

# Node Environment
NODE_ENV=production

# Singapore Timezone (Critical for holiday/reminder calculations)
TZ=Asia/Singapore

# Database - Railway Persistent Volume
DATABASE_PATH=/data/todos.db

# WebAuthn Configuration
# IMPORTANT: Update these with your actual Railway domain after deployment
NEXT_PUBLIC_RP_ID=your-app-production.up.railway.app
NEXT_PUBLIC_RP_NAME=Todo App
NEXT_PUBLIC_ORIGIN=https://your-app-production.up.railway.app

# Application URLs
NEXT_PUBLIC_APP_NAME=Todo App
NEXT_PUBLIC_APP_URL=https://your-app-production.up.railway.app

# Next.js
NEXT_TELEMETRY_DISABLED=1

# Railway automatically provides:
# PORT - Dynamic port assignment
# RAILWAY_PUBLIC_DOMAIN - Your Railway domain
# RAILWAY_ENVIRONMENT - Environment name
