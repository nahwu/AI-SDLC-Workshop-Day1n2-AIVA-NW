# Database Configuration
# Local: Uses SQLite file in project root
# Railway: Uses persistent volume at /data
DATABASE_PATH=./todos.db
# For Railway deployment, set: DATABASE_PATH=/data/todos.db

# Application
NEXT_PUBLIC_APP_NAME=Todo App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Singapore Timezone (DO NOT CHANGE - Required for holiday calculations)
TZ=Asia/Singapore

# Node Environment
NODE_ENV=development

# WebAuthn Configuration (Required for Production)
# For Railway deployment, update these with your Railway domain:
# NEXT_PUBLIC_RP_ID=your-app-production.up.railway.app
# NEXT_PUBLIC_RP_NAME=Todo App
# NEXT_PUBLIC_ORIGIN=https://your-app-production.up.railway.app

# Railway-specific (automatically provided by Railway)
# PORT=3000
# RAILWAY_PUBLIC_DOMAIN=your-app-production.up.railway.app
# RAILWAY_ENVIRONMENT=production

